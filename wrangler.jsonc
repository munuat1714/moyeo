{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moyeo",
  "account_id": "5cd397fa6932f9da1dd3355900a182f8",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/demo", "/app"]
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moyeo-db",
      "database_id": "bc01a8d6-5e99-450c-8549-cb2d8ebd7c57",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 15 * * *"]
  },
  "vars": {
    "DATA_REGION": "BUSAN"
  }
}
