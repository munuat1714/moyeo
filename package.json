{
  "name": "modu-trip-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/prepare-sites.mjs",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker",
    "typecheck:app": "tsc -p tsconfig.app.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint app src worker",
    "android:sync": "cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:aab": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "preview": "vinext start",
    "start": "vinext start"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "lucide-react": "^0.468.0",
    "pretendard": "1.3.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "~5.7.2",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@eslint/js": "^9.39.1",
    "@mdx-js/rollup": "^3.0.0",
    "@types/react": "^19.2.12",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-rsc": "^0.5.23",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "postcss": "^8.5.23",
    "react-server-dom-webpack": "^19.2.6",
    "typescript-eslint": "^8.67.0",
    "vinext": "^0.0.49",
    "vitest": "^3.0.5",
    "wrangler": "^4.112.0"
  }
}
